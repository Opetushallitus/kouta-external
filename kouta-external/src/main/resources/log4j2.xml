<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="kouta-external">
    <Appenders>
        <Console name="AUDIT" target="SYSTEM_OUT">
            <PatternLayout pattern="%m%n" charset="UTF-8"/>
        </Console>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyyMMdd HH:mm:ss.SSS} %5p %c{1} [%t] %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
        <Logger name="fi.vm.sade.auditlog.Audit" level="INFO" additivity="false">
            <AppenderRef ref="AUDIT"/>
        </Logger>
        <Logger name="com.amazonaws.http" level="INFO"/>
    </Loggers>
</Configuration>
