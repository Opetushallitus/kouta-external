<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="kouta-external">
    <Appenders>
{# raw-endraw -välillä template engine ei tee mitään! #}
{% raw %}
        <RollingFile name="AUDIT" fileName="${sys:user.home}/logs/auditlog_kouta-external.log" append="true"
                     filePattern="${sys:user.home}/logs/auditlog_kouta-external.log.%i">
            <PatternLayout pattern="%m%n" charset="UTF-8"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="20MB"/>
            </Policies>
            <DefaultRolloverStrategy max="20" fileIndex="min"/>
        </RollingFile>
        <Console name="STDOUT" target="SYSTEM_OUT">
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} %-5p {%X{user}} [%t] %-5p %c: %m%n"/>
        </Console>
        <RollingFile name="FILE" fileName="${sys:user.home}/logs/oph-kouta-external.log" append="true"
                     filePattern="${sys:user.home}/logs/oph-kouta-external.log.%i">
            <PatternLayout pattern="%d{yyyy-MM-dd'T'HH:mm:ss.SSSX} %-5p {%X{user}} [%t] %-5p %c: %m%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="100" fileIndex="min"/>
        </RollingFile>
{% endraw %}
    </Appenders>
    <Loggers>
        <Root level="{{env_loglevel}}">
            <AppenderRef ref="FILE"/>
            <AppenderRef ref="STDOUT"/>
        </Root>
        <!-- By default hide these spammers -->
        <Logger name="org.apache.cxf" level="error"/>
        <Logger name="org.springframework" level="error"/>
        <Logger name="org.vaadin" level="error"/>
        <Logger name="javax.sql" level="error"/>
        <Logger name="org.apache.activemq" level="info"/>
        <Logger name="org.apache.activemq.spring" level="{{env_loglevel}}"/>
        <!-- cas session + singlelogout tracing -->
        <Logger name="org.jasig.cas.client.session" level="info"/>
        <Logger name="org.flywaydb" level="info"/>
        <Logger name="fi.oph.kouta.external.elasticsearch" level="debug"/>
        <!-- Audit logging -->
        <Logger name="fi.vm.sade.auditlog.Audit" level="info" additivity="false">
            <AppenderRef ref="AUDIT"/>
        </Logger>
    </Loggers>
</Configuration>
